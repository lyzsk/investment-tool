<?xml version="1.0" encoding="UTF-8"?>
<!--
  - 控制台: 照旧(Spring Boot 默认样式)
  - logs/inv-admin.log: 全量 INFO+, 按天滚动 + 单文件 100MB 再切, 保留 30 天, 总量封顶 3GB
  - logs/inv-admin-error.log: 只放 WARN/ERROR, 查问题先看它; 保留 60 天
  - MyBatis SQL 走 Slf4jImpl(application.yml), 默认不打印; 要看 SQL 把下面 SQL_LEVEL 改 DEBUG
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <springProperty scope="context" name="ROOT_DIR" source="project.root-dir" defaultValue="."/>
    <property name="LOG_DIR" value="${ROOT_DIR}/logs"/>
    <property name="FILE_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{40} - %msg%n"/>
    <property name="SQL_LEVEL" value="INFO"/>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/inv-admin.log</file>
        <encoder>
            <pattern>${FILE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/inv-admin.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>3GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/inv-admin-error.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>WARN</level>
        </filter>
        <encoder>
            <pattern>${FILE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/inv-admin-error.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>60</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- MyBatis mapper 接口所在包(SQL 语句在 DEBUG 级别输出) -->
    <logger name="cn.sichu" level="INFO"/>
    <logger name="cn.sichu.system.quartz.mapper" level="${SQL_LEVEL}"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </root>
</configuration>
